APP_NAME=ai-mentor
APP_ENV=dev
LOG_LEVEL=INFO

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=mentor
POSTGRES_PASSWORD=mentor
POSTGRES_DB=mentor

REDIS_HOST=redis
REDIS_PORT=6379

# LLM (заполним на этапе интеграции)
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=

# Этика / ПДн
PII_MASKING_ENABLED=true
DISCLAIMER_ENABLED=true

# Dev-окружение (по умолчанию)
DATABASE_URL=sqlite+aiosqlite:///./mentor.db

# LLM-тюнинг
LLM_CACHE_TTL=300
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RESET_SECONDS=30